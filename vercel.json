{
  "rewrites": [
    {
      "source": "/api/auth/unified-login",
      "destination": "https://telecomax-api-dev.vercel.app/api/auth/unified-login"
    },
    {
      "source": "/api/auth/unified-refresh",
      "destination": "https://telecomax-api-dev.vercel.app/api/auth/unified-refresh"
    },
    {
      "source": "/api/auth/unified-logout",
      "destination": "https://telecomax-api-dev.vercel.app/api/auth/unified-logout"
    },
    {
      "source": "/api/operations",
      "destination": "https://telecomax-api-dev.vercel.app/api/operations"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}